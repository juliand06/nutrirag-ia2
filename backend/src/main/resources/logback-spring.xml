<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="nutrirag-ia2-backend"/>
    <springProperty scope="context" name="ENV_PROFILE" source="spring.profiles.active" defaultValue="demo"/>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}","level":"%level","service":"${APP_NAME}","env":"${ENV_PROFILE}","thread":"%thread","traceId":"%X{traceId:-none}","logger":"%logger{36}","message":"%replace(%msg){'\"','\\\"'}"}%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
