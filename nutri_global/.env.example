# Proveedor activo: gemini | groq | openrouter | ollama | openai
LLM_PROVIDER=gemini

# Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=clave_configurada_localmente
GEMINI_MODEL=gemini-flash-latest

# Alternativas gratuitas (solo si cambias LLM_PROVIDER)
# GROQ_API_KEY=clave_configurada_localmente
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=clave_configurada_localmente
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OLLAMA_MODEL=qwen2.5:7b
# OPENAI_API_KEY=clave_configurada_localmente
# OPENAI_MODEL=gpt-4o-mini

