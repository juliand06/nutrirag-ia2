# ============================================================================
# VARIABLES DE ENTORNO STAGING / PRODUCCIÓN (NO VERSIONAR SECRETOS REALES)
# ============================================================================
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Base de datos PostgreSQL + pgvector
POSTGRES_DB=nutrirag_prod_db
POSTGRES_USER=nutrirag_prod_user
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Seguridad, JWT y Cifrado AES-256-GCM en reposo
JWT_SECRET=replace-with-at-least-256-bit-random-jwt-secret
ENCRYPTION_MASTER_KEY=replace-with-32-byte-master-encryption-key
CORS_ALLOWED_ORIGINS=https://app.nutristudio.example.com

# IA (Solo en Backend — nunca en Frontend)
AI_PROVIDER=GEMINI
GEMINI_API_KEY=
OPENAI_API_KEY=

# SMART on FHIR R4
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Stripe Billing (Live / Test)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me

# Observabilidad
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# Frontend build args públicos (cero secretos privados)
VITE_API_BASE_URL=https://api.nutristudio.example.com/api
VITE_FHIR_SANDBOX_URL=https://hapi.fhir.org/baseR4
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
VITE_SENTRY_DSN=
